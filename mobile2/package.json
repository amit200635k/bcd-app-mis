{
  "name": "bcd-mobile",
  "version": "0.1.0",
  "description": "BCD Survey — offline-first dynamic survey mobile app (Capacitor + Alpine.js + Bootstrap + SQLite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "android": "npm run sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "alpinejs": "^3.15.0",
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/alpinejs": "^3.13.11",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
