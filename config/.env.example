# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME="BCD Survey Platform"
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/bcd-app
APP_BASE_PATH=/bcd-app

# Database (primary)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bcd_survey
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=bcd-app
JWT_TTL=86400
JWT_REFRESH_TTL=604800

# Security
PASSWORD_MIN_LENGTH=8
SESSION_LIFETIME=7200
RATE_LIMIT_PER_MINUTE=60
