# BCD Survey Platform — Apache rewrite
# Route all API requests to the front controller.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /bcd-app/

    # API — route everything under /api to api/index.php
    # (unless a real script exists there, e.g. dropdowns.php / user_data.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api(?:/(.*))?$ api/index.php [L,QSA]

    # MIS portal
    RewriteRule ^mis/?$ mis/index.php [L,QSA]

    # GIS
    RewriteRule ^gis/?$ gis/index.php [L,QSA]
</IfModule>
